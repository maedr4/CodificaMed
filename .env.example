# Copie este archivo como .env y complete los valores.

# Motor por defecto: reglas | ollama | gemini | claude | openai
PROVEEDOR_LLM=ollama

# Modelo local con Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=llama3.2:3b

# API externa de Google Gemini (clave gratuita en https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.5-flash-lite

# API externa de Anthropic (Claude, opcional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-sonnet-5-5

# API externa de OpenAI (opcional)
OPENAI_API_KEY=
OPENAI_MODELO=gpt-4o-mini

# Recuperación de candidatos
TOP_K=4
MAX_CANDIDATOS=30
TIMEOUT_SEGUNDOS=180
